---
import Button from '@deramond.dev/astro/components/Button.astro';
import GlyphPress from '@deramond.dev/astro/components/GlyphPress.astro';
import SiteLayout from '@deramond.dev/astro/layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" description="It's freezing out there! Return to the Winter Open Source Village, traveller." noindex>
	<section class="d-pnf" aria-labelledby="nf-title">
		<GlyphPress glyph="404" size={240} width={432} height={168} x={-2.4} y={168} class="d-pnf__num" />
		<p class="d-pnf__code">Error 404</p>
		<h1 id="nf-title" class="d-pnf__title">It's <span class="accent-mark">freezing</span> out there!</h1>
		<p class="d-pnf__lead">Return to the <em>Winter Open Source Village</em>, traveller…</p>
		<div class="d-pnf__actions">
			<Button variant="primary" href="/advent/">Back to the village</Button>
		</div>
	</section>
</SiteLayout>
