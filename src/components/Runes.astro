---
import Rune from './Rune.astro';

const runes = [
	{ type: 'snowflake', name: 'Snowflake rune', text: "Beginner, you're starting a new project" },
	{ type: 'snowball', name: 'Snowball rune', text: 'Intermediate, you already have a project and want to enhance it' },
	{ type: 'ice', name: 'Ice rune', text: 'Advanced, you already have a large or several projects and want to go further' },
] as const;
---

<ul class="runes not-prose">
	{
		runes.map((r) => (
			<li>
				<Rune type={r.type} size={72} />
				<b>{r.name}</b>
				<span>{r.text}</span>
			</li>
		))
	}
</ul>

<style>
	/* Printed on the page, no relief: each rune in ink over a strong line, its name in Chakra, its level muted. */
	.runes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 32px;
		padding: 0;
		margin-block: 32px 0;
		list-style: none;
	}
	.runes li {
		display: grid;
		justify-items: start;
		align-content: start;
		gap: 10px;
		margin: 0;
		padding-top: 22px;
		border-top: 1px solid var(--paper-color-line-strong);
	}
	.runes b {
		margin-top: 6px;
		font: 600 13px / 1.3 var(--paper-font-family-title);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--paper-color-ink);
	}
	.runes span { font-size: 15px; line-height: 1.5; color: var(--paper-color-muted); }
</style>
