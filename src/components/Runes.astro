---
import Rune from './Rune.astro';

const runes = [
	{ type: 'snowflake', name: 'Snowflake rune', text: "Beginner, you're starting a new project" },
	{ type: 'snowball', name: 'Snowball rune', text: 'Intermediate, you already have a project and want to enhance it' },
	{ type: 'ice', name: 'Ice rune', text: 'Advanced, you already have a large or several projects and want to go further' },
] as const;
---

<ul class="runes not-prose">
	{
		runes.map((r) => (
			<li>
				<Rune type={r.type} size={72} />
				<b>{r.name}</b>
				<span>{r.text}</span>
			</li>
		))
	}
</ul>

<style>
	.runes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: var(--space-4);
		padding: 0;
		margin-block: var(--space-6);
		list-style: none;
	}
	.runes li {
		display: grid;
		justify-items: center;
		gap: var(--space-2);
		padding: var(--space-6) var(--space-5);
		text-align: center;
		background: var(--color-panel);
		border: var(--stroke-ui) solid var(--color-line);
		margin: 0;
	}
	.runes b {
		font-family: var(--font-family-display);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--font-letter-spacing-eyebrow);
		color: var(--color-fg);
	}
	.runes span { color: var(--color-muted); font-size: var(--font-size-sm); }
</style>
