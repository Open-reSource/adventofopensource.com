---
import Rune from './Rune.astro';

interface Props { type: 'snowflake' | 'snowball' | 'ice' }
const { type } = Astro.props;
const label = {
	snowflake: ['Snowflake rune', 'Beginner level for folks starting a new artifact'],
	snowball: ['Snowball rune', 'Intermediate level for folks wanting to enhance an existing artifact'],
	ice: ['Ice rune', 'Advanced level for folks wanting to enhance an existing large artifact or several org/personal artifacts'],
}[type];
---

<div class="heading-rune">
	<Rune type={type} size={44} />
	<p><b>{label[0]}</b><span>{label[1]}</span></p>
</div>

<style>
	.heading-rune {
		display: flex;
		gap: 16px;
		align-items: center;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--paper-color-line-strong);
	}
	.heading-rune + :global(*) { margin-top: 24px; }
	.heading-rune p { margin: 0; display: grid; gap: 3px; }
	.heading-rune b {
		font: 600 13px / 1.3 var(--paper-font-family-title);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--paper-color-ink);
	}
	.heading-rune span { font-size: 15px; line-height: 1.45; color: var(--paper-color-muted); }
	@media (max-width: 640px) {
		.heading-rune { gap: 12px; }
		.heading-rune :global(svg) { width: 36px; height: 36px; }
	}
</style>
