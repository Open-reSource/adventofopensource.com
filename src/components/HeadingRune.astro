---
import Rune from './Rune.astro';

interface Props { type: 'snowflake' | 'snowball' | 'ice' }
const { type } = Astro.props;
const label = {
	snowflake: ['Snowflake rune', 'Beginner level for folks starting a new artifact'],
	snowball: ['Snowball rune', 'Intermediate level for folks wanting to enhance an existing artifact'],
	ice: ['Ice rune', 'Advanced level for folks wanting to enhance an existing large artifact or several org/personal artifacts'],
}[type];
---

<div class="heading-rune">
	<Rune type={type} size={44} />
	<p><b>{label[0]}</b><span>{label[1]}</span></p>
</div>

<style>
	.heading-rune {
		display: flex;
		gap: var(--space-4);
		align-items: center;
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-5);
		border-bottom: var(--stroke-ui) solid var(--color-line);
	}
	.heading-rune p { margin: 0; display: grid; gap: var(--space-1); }
	.heading-rune b {
		font-family: var(--font-family-display);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--font-letter-spacing-eyebrow);
		font-size: 0.875rem;
	}
	.heading-rune span { color: var(--color-muted); font-size: 0.875rem; line-height: 1.5; }
</style>
