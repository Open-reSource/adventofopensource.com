---
/**
 * A day's story, told apart from the challenges: a letter on a plate pressed into the page, its top edge punched
 * (src/styles/site.css, section 2). The rune of the track opens it; `type="logo"` opens it with the mark, pressed.
 */
import MarkPress from '@deramond.dev/astro/components/MarkPress.astro';
import HeadingRune from './HeadingRune.astro';

interface Props { type?: 'logo' | 'snowflake' | 'snowball' | 'ice' }
const { type } = Astro.props;
---

<div class="lore plate">
	{type === 'logo' && <div class="lore-mark"><MarkPress size={64} /></div>}
	{type && type !== 'logo' && <HeadingRune type={type} />}
	<slot />
</div>
